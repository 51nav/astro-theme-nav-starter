---
import Layout from '../../layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';
import type { Config, Site } from '../../types/config';
import configData from '../../data/config.json';
import Giscus from '../../components/Giscus.astro';
import QRCode from '../../components/QRCode.astro';
import slugify from '../../utils/slug';
import getFaviconUrl, { getDomain } from '../../utils/favicon';

export const getStaticPaths = (async () => {
  const config = configData as Config;
  const paths: {
    params: { slug: string };
    props: { site: Site; category: string; subcategory?: string };
  }[] = [];
  const usedSlugs = new Set<string>();

  const pushPath = (site: Site, category: string, subcategory?: string) => {
    const slug = slugify(site.title);

    if (usedSlugs.has(slug)) {
      throw new Error(`发现重复 slug: ${slug}（站点：${site.title}）`);
    }

    usedSlugs.add(slug);
    paths.push({
      params: { slug },
      props: { site, category, subcategory }
    });
  };

  config.menuItems.forEach((item) => {
    if (item.type === 'single' && item.sites) {
      item.sites.forEach((site) => pushPath(site, item.name));
    }

    if (item.type === 'tabs' && item.submenu) {
      item.submenu.forEach((subItem) => {
        subItem.sites.forEach((site) => pushPath(site, item.name, subItem.name));
      });
    }
  });

  return paths;
}) satisfies GetStaticPaths;

const { site, category, subcategory } = Astro.props;
const { title, description, url } = site;

const getCategoryHref = (categoryName: string) => {
  const config = configData as Config;
  return config.categoryMap[categoryName] || categoryName;
};

const domain = getDomain(url);
const logoUrl = getFaviconUrl(url, 128);
---

<Layout title={`${title} - Affiliate导航`} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white rounded-lg shadow-sm p-6">
      <nav class="mb-4 text-sm text-gray-500">
        <a href="/" class="hover:text-blue-600">首页</a>
        <span class="mx-2">/</span>
        <a href={`/#${getCategoryHref(category)}`} class="hover:text-blue-600">
          {category}
        </a>
        {subcategory && (
          <>
            <span class="mx-2">/</span>
            <span class="text-gray-900">{subcategory}</span>
          </>
        )}
      </nav>

      <div class="flex items-start gap-6">
        <div class="bg-white rounded-lg">
          <img
            src={logoUrl}
            alt={title}
            width="64"
            height="64"
            class="rounded-lg object-contain"
            loading="eager"
            decoding="sync"
            data-domain={domain}
            data-fallback-favicons
          />
        </div>
        <div class="flex-1">
          <h1 class="text-2xl font-bold text-gray-900 mb-2">{title}</h1>
          <p class="text-gray-500 mb-4">{description}</p>
          <div class="flex items-center gap-4">
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700"
            >
              <span>访问网站</span>
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
              </svg>
            </a>
            <button
              type="button"
              class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700"
              id="showQRCode"
              data-url={url}
            >
              <span>手机查看</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 11h8V3H3v8zm2-6h4v4H5V5zM3 21h8v-8H3v8zm2-6h4v4H5v-4zM13 3v8h8V3h-8zm6 6h-4V5h4v4zM13 13h2v2h-2v-2zm0 4h2v2h-2v-2zm4 0h2v2h-2v-2zm0-4h2v2h-2v-2z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div id="qrCodeDisplay" class="hidden mt-4">
        <QRCode url={url} title={title} />
      </div>

      <div class="mt-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">优势:</h2>
        <ul class="space-y-2 text-gray-600">
          {site.advantages?.map((advantage: string) => (
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>{advantage}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">相关导航</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {site.related?.map((item: { title: string; description: string }) => (
            <a
              href={`/sites/${slugify(item.title)}`}
              class="block p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-sm transition-all"
            >
              <div class="font-medium text-gray-900">{item.title}</div>
              <div class="text-sm text-gray-500 mt-1">{item.description}</div>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-8">
        <Giscus
          repo="51nav/51nav.github.io"
          repoId="R_kgDONT50Hg"
          category="Announcements"
          categoryId="DIC_kwDONT50Hs4CkpQJ"
          mapping="pathname"
          theme="light"
        />
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const showQRCode = document.getElementById('showQRCode');
    const qrCodeDisplay = document.getElementById('qrCodeDisplay');

    if (showQRCode && qrCodeDisplay) {
      showQRCode.addEventListener('click', () => {
        qrCodeDisplay.classList.toggle('hidden');
      });
    }

    document.querySelectorAll('[data-fallback-favicons]').forEach((imgEl) => {
      const image = imgEl as HTMLImageElement;
      const host = image.dataset.domain;
      if (!host) return;

      const sources = [
        `https://${host}/favicon.ico`,
        `https://api.iowen.cn/favicon/${host}.png`,
        `https://icon.horse/icon/${host}`,
        `https://favicons.githubusercontent.com/${host}`
      ];

      let index = 0;
      image.addEventListener('error', () => {
        if (index < sources.length) {
          image.src = sources[index++];
        } else {
          image.style.display = 'none';
        }
      });
    });
  });
</script>
