---
import styles from '../styles/components/tabpanel.module.css';
import type { SubMenuItem } from '../types/config';
import NavCard from './NavCard.astro';

interface Props {
  tabs: SubMenuItem[];
}

const { tabs } = Astro.props;
---

<div class={styles.container}>
  <div class={styles.nav}>
    <nav class={styles.navList} aria-label="Tabs" role="tablist">
      {tabs.map((tab, index) => {
        const tabId = `tab-${tab.href.slice(1)}`;
        const panelId = `panel-${tab.href.slice(1)}`;

        return (
          <button
            id={tabId}
            role="tab"
            type="button"
            class={styles.button}
            data-index={index}
            data-section={tab.href.slice(1)}
            aria-selected={index === 0}
            aria-controls={panelId}
            tabindex={index === 0 ? 0 : -1}
            data-tab-trigger
          >
            {tab.name}
          </button>
        );
      })}
    </nav>
  </div>

  <div class={styles.panels}>
    {tabs.map((tab, index) => {
      const tabId = `tab-${tab.href.slice(1)}`;
      const panelId = `panel-${tab.href.slice(1)}`;

      return (
        <div
          id={panelId}
          role="tabpanel"
          aria-labelledby={tabId}
          class={styles.panel}
          data-index={index}
          data-active={index === 0}
          data-tab-panel
        >
          {tab.sites.map((site) => (
            <NavCard {...site} />
          ))}
        </div>
      );
    })}
  </div>
</div>

<script>
  function initTabs(): void {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]');
    const tabPanels = document.querySelectorAll<HTMLDivElement>('[data-tab-panel]');

    function switchTab(index: number): void {
      tabButtons.forEach((button, i) => {
        const selected = i === index;
        button.setAttribute('aria-selected', selected.toString());
        button.setAttribute('tabindex', selected ? '0' : '-1');
      });

      tabPanels.forEach((panel, i) => {
        panel.setAttribute('data-active', (i === index).toString());
      });
    }

    tabButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        switchTab(index);
      });

      button.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();

        const nextIndex =
          event.key === 'ArrowRight'
            ? (index + 1) % tabButtons.length
            : (index - 1 + tabButtons.length) % tabButtons.length;

        switchTab(nextIndex);
        tabButtons[nextIndex]?.focus();
      });
    });

    const hash = window.location.hash;
    if (hash) {
      const matchedIndex = Array.from(tabButtons).findIndex((button) => {
        const section = button.getAttribute('data-section');
        return section ? `#${section}` === hash : false;
      });

      if (matchedIndex >= 0) {
        switchTab(matchedIndex);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initTabs);
</script>
