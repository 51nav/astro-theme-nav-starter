---
interface Props {
  repo: string;
  repoId: string;
  category: string;
  categoryId: string;
  mapping: string;
  strict?: string;
  reactionsEnabled?: string;
  emitMetadata?: string;
  inputPosition?: string;
  theme?: string;
  lang?: string;
  loading?: 'lazy' | 'eager';
}

const {
  repo,
  repoId,
  category,
  categoryId,
  mapping = 'pathname',
  strict = '0',
  reactionsEnabled = '1',
  emitMetadata = '0',
  inputPosition = 'bottom',
  theme = 'light',
  lang = 'zh-CN',
  loading = 'lazy'
} = Astro.props;
---

<script is:inline
  src="https://giscus.app/client.js"
  data-repo={repo}
  data-repo-id={repoId}
  data-category={category}
  data-category-id={categoryId}
  data-mapping={mapping}
  data-strict={strict}
  data-reactions-enabled={reactionsEnabled}
  data-emit-metadata={emitMetadata}
  data-input-position={inputPosition}
  data-theme={theme}
  data-lang={lang}
  data-loading={loading}
  crossorigin="anonymous"
  async
></script>
